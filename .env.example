# Copiar a .env.local en tu computador y a variables de entorno en Vercel.
# No commitear valores reales.

# Cuenta de Gmail que envía el formulario (SMTP).
GMAIL_USER=

# Clave de aplicación de Google, no la contraseña normal de Gmail.
# Se crea en https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Destino del mensaje. Si se omite, el código usa contacto@protef.cl.
CONTACT_TO=contacto@protef.cl

# Etiquetas de conversión de Google Ads. [CONFIRMAR]
# El ID AW-18242608384 ya está en el sitio. Aquí va solo la etiqueta, por ejemplo AbC123.
NEXT_PUBLIC_ADS_PHONE_LABEL=
NEXT_PUBLIC_ADS_WHATSAPP_LABEL=
NEXT_PUBLIC_ADS_FORM_LABEL=
